{
  "manifest_version": 3,
  "name": "Speed Buttons",
  "version": "1.0",
  "description": "Extension with 10 speed buttons (1x to 10x)",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }

}
